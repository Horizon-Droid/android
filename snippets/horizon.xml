<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="HorizonDroid"
          fetch="https://github.com/HorizonV2"
	  sync-c="true"
          sync-j="4"
          revision="refs/heads/lineage-22.2" />
  
  <remote name="axion-gitlab"
          fetch="https://gitlab.com/AxionAOSP/"
          sync-c="true"
          sync-j="4"
          revision="refs/heads/lineage-22.1" />

  <remote name="crdroid-gitlab"
          fetch="https://gitlab.com/crdroidandroid/"
          sync-c="true"
          sync-j="4"
          revision="refs/heads/15.0" />

  <project path="android" name="android" remote="HorizonDroid" />

  <!-- Build -->
  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="HorizonDroid" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed,sysui-studio" remote="HorizonDroid" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <project path="build/release" name="android_build_release" groups="pdk,tradefed,sysui-studio" remote="HorizonDroid" />
  <project path="bionic" name="android_bionic" groups="pdk" remote="HorizonDroid" />
  <project path="system/core" name="android_system_core" groups="pdk" remote="HorizonDroid" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="android_frameworks_av" groups="pdk" remote="HorizonDroid" />
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="HorizonDroid" />
  <project path="frameworks/native" name="android_frameworks_native" groups="pdk" remote="HorizonDroid" />
  <project path="frameworks/libs/systemui" name="android_frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="HorizonDroid" />
  <project path="frameworks/opt/telephony" name="android_frameworks_opt_telephony" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="HorizonDroid" />

  <!-- AOSP Modules  -->
  <project path="packages/modules/Bluetooth" name="android_packages_modules_Bluetooth" groups="pdk" remote="HorizonDroid" />
  <project path="packages/modules/Wifi" name="android_packages_modules_Wifi" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="HorizonDroid" />

  <!-- Packages -->
  <project path="packages/apps/HorizonLab" name="android_packages_apps_HorizonLab" remote="HorizonDroid" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="HorizonDroid" />
  <project path="packages/apps/GameSpace" name="android_packages_apps_GameSpace" remote="HorizonDroid" />
  <project path="packages/apps/Messaging" name="android_packages_apps_Messaging" groups="pdk-fs" remote="HorizonDroid" />
  <project path="packages/apps/Contacts" name="android_packages_apps_Contacts" groups="pdk-fs" remote="HorizonDroid" />
  <project path="packages/apps/LMOFreeform" name="android_packages_apps_LMOFreeform" remote="HorizonDroid" />
  <project path="packages/apps/Backgrounds" name="android_packages_apps_Backgrounds" remote="HorizonDroid" />
  <project path="packages/apps/Trebuchet" name="android_packages_apps_Trebuchet" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="HorizonDroid" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="HorizonDroid" />
  <project path="packages/apps/SetupWizard" name="android_packages_apps_SetupWizard" groups="pdk-fs,pdk-cw-tvc" remote="HorizonDroid" />
  <project path="packages/apps/FaceUnlock" name="android_packages_apps_FaceUnlock" remote="crdroid-gitlab" />
  <project path="packages/apps/ColumbusService" name="android_packages_apps_ColumbusService" groups="pdk-cw-fs,pdk-fs" remote="HorizonDroid" />
  <project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="HorizonDroid" />
  <project path="packages/apps/Matlog" name="android_packages_apps_Matlog" groups="pdk-fs,sysui-studio" remote="HorizonDroid" />
