  <project path="packages/apps/Dialer" name="android_packages_apps_Dialer" groups="pdk-fs" remote="HorizonDroid" />
  <project path="packages/apps/OmniStyle" name="android_packages_apps_OmniStyle" remote="HorizonDroid" />
  <project path="packages/services/Omnijaws" name="android_packages_services_Omnijaws" groups="pdk-cw-fs,pdk-fs" remote="HorizonDroid" />
