  <project path="vendor/custom-preference" name="android_vendor_custom-preference" remote="HorizonDroid" />
  <project path="vendor/addons" name="vendor_addons" remote="HorizonDroid" />
  <project path="vendor/certification" name="vendor_certification" remote="HorizonDroid" />
